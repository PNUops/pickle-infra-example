[Unit]
Description=Pickle whole-system read-only health snapshot
Documentation=file:///srv/pickle/infra/README.md
After=pve-guests.service
OnFailure=pickle-ops-failure@%n.service

[Service]
Type=oneshot
# Interpreter-invoked for both the wrapper and the check itself — see the
# comment in pickle-db-backup.service. The snapshot never changes service
# state; a non-zero exit only means some check reported FAIL.
ExecStart=/bin/bash /srv/pickle/infra/scripts/cron-wrap.sh health -- /bin/bash /srv/pickle/infra/scripts/health-check.sh
ExecStartPost=/bin/rm -f /var/lib/pickle-ops/unit-failure-%n.fail
# The snapshot exits 1 when some check reports FAIL. That is the snapshot
# doing its job, not the unit failing to run, and the wrapper already records
# it; treating it as a unit failure would raise a second, redundant alarm on
# every ordinary red check. Only an exec or crash failure reaches OnFailure.
SuccessExitStatus=1
# A oneshot has no start timeout by default, so a probe that hangs despite its
# own bound (an LVM command stuck on a suspended device, pct waiting on a wedged
# cluster filesystem) would keep this unit active forever and every later
# timer firing would be skipped as already-running. Ten minutes is far above a
# healthy run (seconds) and far below "nobody notices for a day".
TimeoutStartSec=600
