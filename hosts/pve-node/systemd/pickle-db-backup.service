[Unit]
Description=Pickle dev database backup
Documentation=file:///srv/pickle/infra/runbooks/db-restore.md
# The dump runs `pct exec` into the app container, so the guests must be up
# before this fires. Matters for the catch-up run a Persistent= timer does
# after a boot: without this the catch-up would race container startup.
After=pve-guests.service
# Records a durable marker even when the wrapper below never gets to run
# (missing interpreter, deleted script, permission problem). This is the layer
# cron lacked: it swallowed such failures with no trace anywhere.
OnFailure=pickle-ops-failure@%n.service

[Service]
Type=oneshot
# Both the wrapper and its child are launched through the interpreter on
# purpose. Invoking them directly makes the job depend on the file's execute
# bit, and that dependency is exactly what silently stopped every backup and
# health run for ten days: cron fired, exec failed, nothing was recorded.
ExecStart=/bin/bash /srv/pickle/infra/scripts/cron-wrap.sh db-backup -- /bin/bash /srv/pickle/infra/scripts/db-backup.sh
# Retract this unit's failure marker once it runs clean again. Without this a
# single transient failure would leave the login notice complaining forever.
ExecStartPost=/bin/rm -f /var/lib/pickle-ops/unit-failure-%n.fail
