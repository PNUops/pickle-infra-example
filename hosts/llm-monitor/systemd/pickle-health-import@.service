[Unit]
Description=Import restricted health results from %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=pickle-health-import-%i
StateDirectoryMode=0700
TimeoutStartSec=20
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/pickle/health-result-importer.py --config /etc/pickle-llm-health/import-%i.json --state-dir /var/lib/pickle-health-import-%i
