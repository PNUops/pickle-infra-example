[Unit]
Description=Collect local health results and stable incident transitions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=pickle-service-health-monitor
StateDirectoryMode=0700
TimeoutStartSec=120
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/pickle/service-health-monitor.py --config /etc/pickle-llm-health/collector.json --state-dir /var/lib/pickle-service-health-monitor
