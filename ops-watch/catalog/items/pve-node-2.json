  {
    "id": "prod-jobrunr-worker",
    "host": "pve-node-2",
    "check": "sql",
    "every": 60,
    "group": "internal",
    "user_facing": true,
    "target": "백그라운드 작업 실행기",
    "what": "JobRunr 서버 하트비트",
    "impact": "가상머신 생성과 삭제, 도메인 연결, 알림 메일 같은 예약 작업이 진행되지 않아요.",
    "page_label": "예약 작업",
    "args": {
      "ct": 204,
      "database": "pickle_prod",
      "query": "jobrunr_heartbeat",
      "heartbeat_s": 90,
      "max_workers": 1
    },
    "fail_after": 2
  },
  {
    "id": "prod-recurring-jobs",
    "host": "pve-node-2",
    "check": "sql",
    "every": 120,
    "group": "internal",
    "user_facing": true,
    "target": "예약 작업",
    "what": "반복 작업별 마지막 성공 시각",
    "impact": "멈춘 작업에 따라 가상머신 상태, 도메인 연결, 알림, LLM 사용량 집계가 늦어져요.",
    "page_label": "예약 작업",
    "args": {
      "ct": 204,
      "database": "pickle_prod",
      "query": "recurring_jobs",
      "cadence": {
        "vm-network-path-reconcile": 15,
        "vm-status-poller": 30,
        "domain-verification": 60,
        "gpu-allocation-scheduler": 60,
        "gpu-operation-recovery": 60,
        "gpu-lease": 60,
        "llm-openrouter-account-poll-dispatcher": 60,
        "notification-dispatcher": 60,
        "request-recipient-materializer": 60,
        "route-reconcile": 120,
        "relay-contact-monitor": 120,
        "gpu-utilization-collection": 300,
        "llm-key-daily-quota": 300,
        "llm-usage-rollup": 300,
        "llm-openrouter-provisioner": 300,
        "deletion-sweeper": 300,
        "gpu-attachment-drift": 600,
        "stale-task-recovery": 600,
        "drift-reconciler": 600,
        "domain-reservation-sweeper": 3600,
        "gpu-utilization-review": 3600,
        "llm-openrouter-catalogue-refresh": 3600,
        "vm-expiry": 3600,
        "inference-observation-retention": 3600,
        "domain-renewal-sweeper": 86400,
        "llm-body-retention-sweeper": 86400,
        "llm-usage-retention-sweeper": 86400,
        "notification-retention-sweeper": 86400
      },
      "min_limit": 300
    }
  },
  {
    "id": "prod-failed-jobs",
    "host": "pve-node-2",
    "check": "sql",
    "every": 300,
    "group": "internal",
    "target": "백그라운드 작업",
    "what": "재시도까지 실패한 작업 수",
