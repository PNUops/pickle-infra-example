  {
    "id": "prod-nginx-config",
    "host": "pve-node-2",
    "check": "nginx_config",
    "every": 300,
    "group": "internal",
    "target": "운영 nginx 설정",
    "what": "nginx -t 설정 검사",
    "impact": "지금은 영향이 없지만 다음 인증서 갱신이나 도메인 반영 때 nginx가 설정을 다시 읽지 못해요.",
    "page_label": "운영 진입점",
    "args": {
      "ct": 200
    }
  },
  {
    "id": "prod-certs",
    "host": "pve-node-2",
    "check": "cert_files",
    "every": 3600,
    "group": "internal",
    "user_facing": true,
    "target": "운영 공개 인증서",
    "what": "Let's Encrypt 인증서 세 종의 남은 유효기간",
    "impact": "인증서가 만료되면 브라우저와 LLM 클라이언트가 접속을 거부해요.",
    "page_label": "인증서",
    "args": {
      "ct": 200,
      "paths": [
        "/etc/letsencrypt/live/pickle.pusan.ac.kr/fullchain.pem",
        "/etc/letsencrypt/live/llm.pcl.kr/fullchain.pem",
        "/etc/letsencrypt/live/pusan.dev/fullchain.pem"
      ],
      "warn_days": 20,
      "fail_days": 7
    }
  },
  {
    "id": "pve-node-2-host",
    "host": "pve-node-2",
    "check": "host",
    "every": 60,
    "group": "internal",
    "user_facing": true,
    "target": "운영 서버 호스트",
    "what": "thin pool과 시스템 디스크 사용률, 클러스터 정족수, 시계 오차",
    "impact": "저장 공간이 차면 모든 컨테이너와 가상머신이 읽기 전용이 되고, 정족수를 잃으면 가상머신 생성과 설정 변경이 막혀요.",
    "page_label": "운영 서버",
    "args": {
      "thin_pools": [
        "pve/data"
      ],
      "cluster": true
    },
    "fail_after": 2
  },
  {
    "id": "prod-backup-pin",
    "host": "pve-node-2",
    "check": "backup_pin",
    "every": 900,
    "group": "backup",
    "target": "코어 백업 사전 확인",
