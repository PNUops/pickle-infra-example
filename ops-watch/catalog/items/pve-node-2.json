[
  {
    "id": "prod-edge-ct",
    "host": "pve-node-2",
    "check": "container",
    "every": 60,
    "group": "internal",
    "user_facing": true,
    "target": "운영 TLS 진입점과 프록시 제어기",
    "what": "컨테이너 실행과 nginx, 프록시 에이전트 서비스 상태",
    "impact": "사이트와 LLM API, 가상머신 웹 주소에 접속하지 못하고 새 도메인 연결이 반영되지 않아요.",
    "page_label": "운영 진입점",
    "args": {
      "ct": 200,
      "units": [
        "nginx.service",
        "pickle-proxy-agent.service"
      ]
    }
  },
