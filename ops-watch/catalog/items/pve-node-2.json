    "page_label": "예약 작업",
    "args": {
      "ct": 204,
      "database": "pickle_prod",
      "query": "failed_jobs",
      "window_min": 15
    }
  },
  {
    "id": "prod-llm-failures",
    "host": "pve-node-2",
    "check": "sql",
    "every": 60,
    "group": "internal",
    "user_facing": true,
    "target": "LLM 요청 처리",
    "what": "최근 10분 LLM 요청 실패와 시간 초과 비율",
    "impact": "LLM API 요청 일부가 실패하거나 응답이 오지 않아요.",
    "page_label": "LLM API",
    "args": {
      "ct": 204,
      "database": "pickle_prod",
      "query": "llm_failure_rate",
      "window_min": 10,
      "fail_ratio": 0.2,
      "min_requests": 10
    }
  },
  {
    "id": "prod-contacts",
    "host": "pve-node-2",
    "check": "sql",
    "every": 60,
    "group": "internal",
    "user_facing": true,
    "target": "내부 구성 요소 연결",
