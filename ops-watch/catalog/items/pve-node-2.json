      "ct": 204,
      "database": "pickle_prod",
      "query": "contacts",
      "gateway_max_age_s": 180,
      "route_pending_min": 15
    },
    "fail_after": 2
  },
  {
    "id": "prod-mail-backlog",
    "host": "pve-node-2",
    "check": "sql",
    "every": 120,
    "group": "internal",
    "user_facing": true,
