  },
  {
    "id": "prod-openrouter",
    "host": "pve-node-2",
    "check": "sql",
    "every": 300,
    "group": "internal",
    "target": "OpenRouter 계정",
    "what": "비즈니스 계정 잔액과 잔액 정보 갱신 시각",
    "impact": "잔액이 바닥나면 상용 모델을 쓰는 LLM 요청이 실패해요.",
